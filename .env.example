# Copy to .env (git-ignored). ONE shared Snowflake account + ONE shared EverOS key across both machines.
# Lane A creates/fills the Snowflake values; Lane B creates/fills the EverOS key. Share via a secure channel.
SNOWFLAKE_USER=
SNOWFLAKE_PAT=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=HACKDB
SNOWFLAKE_SCHEMA=PUBLIC
EVEROS_API_KEY=
